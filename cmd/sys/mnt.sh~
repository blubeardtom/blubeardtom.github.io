#!/bin/bash

dir1=/mnt/home/dev_save/cmd

umount /mnt/dat 2>$dir1/log/umount
umount /mnt/vid 2>$dir1/log/umount

fsck -a /dev/sdb2 2>/dev/null |grep clean
mount /dev/sdb2 /mnt/dat

fsck -a /dev/sdb3 2>/dev/null |grep clean
mount /dev/sdb3 /mnt/vid

for i in {1..4}
do
    echo $i
fsck -a /dev/sdc$i 2>/dev/null |grep clean
mount /dev/sdc$i /mnt/sdc$i
done

